<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/5.0/mei-CMN.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
  <!-- Runs of breaks with no measure between them, which end one page rather than
       one page each (as Verovio engraves them):
         section1: m1, <sb>, m2, <pb>, m3
         section2: <sb><pb>, m4, <pb><pb>, m5, <sb><pb>
       The pair opening section2 is the case met in the wild (Beethoven WoO 66,
       Var. I); <pb><pb> collapses under 'encoded' breaks as well; the pair at the
       end is a trailing run, which opens no page at all.
       'line' breaks: m1 | m2 | m3 | m4 | m5          (5 pages)
       'encoded' breaks: m1 m2 | m3 | m4 | m5         (4 pages) -->
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Adjacent breaks</title>
      </titleStmt>
      <pubStmt>
        <availability>
          <useRestrict>Created for mei-friend e2e tests; public domain.</useRestrict>
        </availability>
      </pubStmt>
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv xml:id="mdivBreaks">
        <score>
          <scoreDef>
            <staffGrp>
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2" meter.count="4" meter.unit="4" keysig="0"/>
            </staffGrp>
          </scoreDef>
          <section xml:id="sectionOne">
            <measure xml:id="mB1" n="1">
              <staff n="1">
                <layer n="1">
                  <note xml:id="noteB1" dur="1" oct="4" pname="c"/>
                </layer>
              </staff>
            </measure>
            <sb xml:id="sbAfterB1"/>
            <measure xml:id="mB2" n="2">
              <staff n="1">
                <layer n="1">
                  <note xml:id="noteB2" dur="1" oct="4" pname="d"/>
                </layer>
              </staff>
            </measure>
            <pb xml:id="pbAfterB2"/>
            <measure xml:id="mB3" n="3">
              <staff n="1">
                <layer n="1">
                  <note xml:id="noteB3" dur="1" oct="4" pname="e"/>
                </layer>
              </staff>
            </measure>
          </section>
          <section xml:id="sectionTwo">
            <sb xml:id="sbOpeningTwo"/>
            <pb xml:id="pbOpeningTwo"/>
            <measure xml:id="mB4" n="4">
              <staff n="1">
                <layer n="1">
                  <note xml:id="noteB4" dur="1" oct="4" pname="f"/>
                </layer>
              </staff>
            </measure>
            <pb xml:id="pbAfterB4"/>
            <pb xml:id="pbAfterB4Second"/>
            <measure xml:id="mB5" n="5">
              <staff n="1">
                <layer n="1">
                  <note xml:id="noteB5" dur="1" oct="4" pname="g"/>
                </layer>
              </staff>
            </measure>
            <sb xml:id="sbTrailing"/>
            <pb xml:id="pbTrailing"/>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>
